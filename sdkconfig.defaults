CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247

CONFIG_RNDL_GPIO=10
CONFIG_RNDL_ROWS=16
CONFIG_RNDL_COLS=16

# Eternaglo Pico: relay on GPIO 1, active high. Data on GPIO 10, button on GPIO 9.
CONFIG_RNDL_RELAY_GPIO=1
CONFIG_RNDL_RELAY_ACTIVE_LOW=n
CONFIG_RNDL_BUTTON_GPIO=9

# Release build defaults. Override per-build with -DSDKCONFIG_DEFAULTS.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Advertise a fixed 15ms preference via PPCP, GAP 0x2A04
# Hint only; see ble_pixel_service.c for the active request.
CONFIG_BT_NIMBLE_SVC_GAP_PPCP_MIN_CONN_INTERVAL=12
CONFIG_BT_NIMBLE_SVC_GAP_PPCP_MAX_CONN_INTERVAL=12
CONFIG_BT_NIMBLE_SVC_GAP_PPCP_SLAVE_LATENCY=0
CONFIG_BT_NIMBLE_SVC_GAP_PPCP_SUPERVISION_TMO=400
